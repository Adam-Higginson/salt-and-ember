[node name="JettyCottage" type="Node3D"]
editor_description = "Meshy model (docs/meshy.md, Model library): assets/third_party/meshy/jetty_cottage, drawn by the Model node. Attach points: LanternHook (the empty bracket by the door), SmokeOut (the chimney top; Smoke hangs from it), SiblingVoice (where the sibling calls from) and BigWindow (the glow in the shuttered window, with WindowLight). The greybox shows when the art is missing, with its own window (BigWindowGreybox) on the body's face, since the model's glow sits inside the greybox wall."

