[gd_resource type="Resource" script_class="WaveSettings" format=3]

[ext_resource type="Script" path="res://scripts/sea/wave_layer.gd" id="1_layer"]
[ext_resource type="Script" path="res://scripts/sea/wave_settings.gd" id="2_settings"]

[sub_resource type="Resource" id="Resource_swell"]
script = ExtResource("1_layer")
direction_degrees = 20.0
wavelength = 60.0
amplitude = 0.4
peak = 0.12

[sub_resource type="Resource" id="Resource_waves"]
script = ExtResource("1_layer")
direction_degrees = 6.0
wavelength = 16.0
amplitude = 0.3
peak = 0.4

[sub_resource type="Resource" id="Resource_cross"]
script = ExtResource("1_layer")
direction_degrees = 50.0
wavelength = 10.5
amplitude = 0.15
peak = 0.22

[sub_resource type="Resource" id="Resource_chop"]
script = ExtResource("1_layer")
direction_degrees = 340.0
wavelength = 6.0
amplitude = 0.06
peak = 0.1

[resource]
script = ExtResource("2_settings")
layers = Array[ExtResource("1_layer")]([SubResource("Resource_swell"), SubResource("Resource_waves"), SubResource("Resource_cross"), SubResource("Resource_chop")])
time_scale = 0.8
